{
  "name": "decky-helixsr",
  "version": "0.3.1",
  "description": "Install HelixSR (DLSS-based FSR 3.1 replacement) into Steam games, directly or through OptiScaler",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "rollup -c && node scripts/package.mjs"
  },
  "keywords": ["decky", "plugin", "steam-deck", "helixsr", "optiscaler", "fsr"],
  "author": "PeroTuncay",
  "license": "Unlicense",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
